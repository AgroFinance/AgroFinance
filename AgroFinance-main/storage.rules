rules_version = '2';

// Espejo de firestore.rules: cada usuario (uid de Firebase Anonymous Auth)
// solo puede leer/escribir el archivo original de sus propias sesiones,
// bajo la misma ruta organizaciones/{orgId}/usuarios/{userId}/sesiones/{sesionId}.
service firebase.storage {
  match /b/{bucket}/o {
    match /organizaciones/{orgId}/usuarios/{userId}/sesiones/{sesionId}/{archivo} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 25 * 1024 * 1024
                   // pdf/docx incluidos: las facturas de grifo y los recibos
                   // de luz llegan en PDF y las actas en DOCX. Sin ellos la
                   // subida moría con storage/unauthorized aunque la interfaz
                   // los ofrecía y el motor ya sabe leerlos.
                   && archivo.matches('original[.](xlsx|xls|csv|xml|ods|pdf|docx)');
    }
  }
}
