# ============================================================
# AgroFinance — plantilla de variables de entorno
# ------------------------------------------------------------
# Copia este archivo a `.env.local` (que está en .gitignore y NUNCA
# se versiona) y rellena los valores reales.
#
# Regla: sin el prefijo NEXT_PUBLIC_ = solo la lee el servidor.
# Con NEXT_PUBLIC_ = viaja al navegador y cualquiera puede leerla,
# así que ahí nunca va un secreto.
# ============================================================

# --- Servidor (secretos: nunca llegan al navegador) ---------

# Kapi AI. La lee solo /api/chat en el servidor.
GEMINI_API_KEY=your_gemini_api_key_here

# Claude como respaldo/alternativa a Gemini en Kapi (kapiAI.ts). Opcional —
# si no se define, Kapi sigue funcionando solo con Gemini. Generar en
# https://console.anthropic.com → API Keys. NUNCA pegar la key en el chat
# de Claude Code ni en ningún otro lugar fuera de este archivo — si se
# expone por accidente, revocarla ahí mismo y generar una nueva.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Login maestro — MUERTO desde 2026-09-20, no se usa en ningún lado del
# código (ver CLAUDE.md → Autenticación). El login real hoy es cuenta de
# Firebase por persona. Se deja aquí solo porque nadie ha limpiado este
# archivo de plantilla todavía; no hace falta rellenarlo.
MASTER_USER=admin
MASTER_PASSWORD=cambia_esta_clave

# --- Firebase (públicas por diseño) -------------------------
# Se obtienen con:  firebase apps:sdkconfig WEB --project <tu-proyecto>
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Cola de procesamiento de archivos ----------------------

# Organización a la que se cuelgan las sesiones de carga en Firestore
# (organizaciones/{orgId}/usuarios/{userId}/sesiones/{sesionId}).
# Hoy es una constante: existe un solo cliente real. Ver README.
NEXT_PUBLIC_DEFAULT_ORG_ID=agrofinance-demo-org

# Ponlo en "true" SOLO si corriste `firebase emulators:start` y quieres
# que la app hable con los emuladores locales en vez de con el proyecto
# real. Requiere Java instalado (los emuladores de Firestore/Storage
# son procesos Java).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# --- Opcional -----------------------------------------------

# Prefijo de ruta si la app se sirve bajo un subdirectorio. Vacío en
# Vercel (que sirve desde la raíz).
NEXT_PUBLIC_BASE_PATH=
