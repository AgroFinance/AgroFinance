rules_version = '2';

// ============================================================
// AgroFinance — Reglas de aislamiento por organización/usuario
// ------------------------------------------------------------
// FASE 1: orgId es una constante fija (NEXT_PUBLIC_DEFAULT_ORG_ID) porque
// hoy solo existe UN cliente real (el login maestro). userId SÍ es real:
// viene del uid de Firebase Anonymous Auth, no de un valor inventado en
// el cliente — por eso estas reglas pueden confiar en request.auth.uid.
//
// El cliente solo puede: crear una sesión en estado 'pendiente' sin
// resultado, y cancelarla. Nunca puede escribirse a sí mismo un
// 'completado' ni un 'resultado' — eso lo hace únicamente la Cloud
// Function, vía Admin SDK (que ignora estas reglas por completo).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /organizaciones/{orgId} {
      // Metadata de la organización: legible por cualquier sesión
      // autenticada (no hay datos sensibles a este nivel), pero solo
      // gestionable desde el backend/consola — no por el cliente.
      allow read: if signedIn();
      allow write: if false;

      match /usuarios/{userId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if signedIn() && request.auth.uid == userId;

        match /sesiones/{sesionId} {
          allow read: if signedIn() && request.auth.uid == userId;

          allow create: if signedIn() && request.auth.uid == userId
                        && request.resource.data.estado == 'pendiente'
                        && request.resource.data.resultado == null
                        && request.resource.data.keys().hasAll(['version', 'estado', 'archivo', 'creadoEn']);

          // El cliente puede re-encolar (volver a 'pendiente', reseteando
          // resultado a null) o cancelar una sesión propia — sin importar
          // en qué estado haya quedado antes, incluido 'completado': subir
          // el mismo archivo otra vez para que se recalcule (p. ej. tras
          // arreglar el motor) es un caso de uso real, no una anomalía.
          // Antes esto solo se permitía desde 'pendiente'/'error', así que
          // cualquier archivo que ya hubiera "completado" (aunque fuera con
          // un resultado incorrecto) quedaba trabado en re-subida con
          // "Missing or insufficient permissions" sin ninguna explicación.
          // El cliente nunca puede fabricar 'completado' ni un resultado no
          // nulo — eso sigue siendo terreno exclusivo de la Cloud Function
          // (Admin SDK, fuera del alcance de estas reglas).
          allow update: if signedIn() && request.auth.uid == userId
                        && request.resource.data.estado in ['pendiente', 'cancelado']
                        && (request.resource.data.resultado == resource.data.resultado
                            || (request.resource.data.estado == 'pendiente' && request.resource.data.resultado == null));

          allow delete: if false;
        }
      }
    }

    // Perfil de cuenta real (email/contraseña o Google) — creado por
    // AuthContext en el primer registro/login. orgId adentro == uid: una
    // organización por cuenta en esta fase.
    match /usuarios/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Colecciones planas (analyses/chats/registros): cada doc lleva un
    // campo `uid` con quien lo escribió (ver firebaseService.ts /
    // analysisRepository.ts / chatRepository.ts) — antes cualquier sesión
    // autenticada leía/escribía los documentos de cualquier otra cuenta,
    // ahora solo el dueño.
    match /{collection}/{docId} {
      allow read: if collection in ['analyses', 'chats', 'registros']
                  && signedIn() && resource.data.uid == request.auth.uid;
      allow create: if collection in ['analyses', 'chats', 'registros']
                    && signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if collection in ['analyses', 'chats', 'registros']
                    && signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
